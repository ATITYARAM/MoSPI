---
const categories = [
  {
    name: "Annual Survey of Industries",
    short: "ASI",
    key: "Annual Survey of Industries"
  },
  {
    name: "Index of Industrial Production",
    short: "IIP",
    key: "Index of Industrial Production"
  },
  {
    name: "Household Consumption Expenditure",
    short: "HCES",
    key: "Household Consumption Expenditure"
  },
  {
    name: "Economic Census",
    short: "EC",
    key: "Economic Census"
  },
  {
    name: "Enterprises Surveys",
    short: "ES",
    key: "Enterprises Surveys"
  },
  {
    name: "Periodic Labour Force Survey",
    short: "PLFS",
    key: "Periodic Labour Force Survey"
  },
  {
    name: "Employment and Unemployment",
    short: "EUE",
    key: "Employment and Unemployment"
  },
  {
    name: "Land and Livestock Holding Surveys",
    short: "LLHS",
    key: "Land and Livestock Holding Surveys"
  },
  {
    name: "Other Surveys",
    short: "OTHER",
    key: "Other Surveys"
  }
];
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Dataset Explorer | MoSPI</title>
</head>

<body>

  <main class="explorer">

    <!-- =========================
         SURVEY SELECTION PAGE
    ========================== -->

    <section id="survey-page">

      <header class="page-header">

        <div>
          <p class="eyebrow">MoSPI MICRODATA</p>

          <h1>Dataset Explorer</h1>

          <p class="subtitle">
            Browse datasets by survey category
          </p>
        </div>

        <a href="/" class="back-button">
          ← Back
        </a>

      </header>

      <section class="category-grid">

        {
          categories.map((category) => (
            <button
              class="category-card"
              data-category={category.key}
            >

              <span class="category-code">
                {category.short}
              </span>

              <span class="category-name">
                {category.name}
              </span>

              <span class="category-arrow">
                →
              </span>

            </button>
          ))
        }

      </section>

    </section>


    <!-- =========================
         DATASET PAGE
    ========================== -->

    <section id="dataset-page" class="hidden">

      <header class="dataset-header">

        <button
          id="back-surveys"
          class="back-surveys"
        >
          ← All Surveys
        </button>

        <div class="dataset-heading">

          <p class="eyebrow">
            MoSPI MICRODATA
          </p>

          <h1 id="selected-category">
            Dataset
          </h1>

          <p class="subtitle">
            Available datasets in this survey
          </p>

        </div>

        <span
          id="dataset-count"
          class="count"
        ></span>

      </header>


      <div
        id="loading"
        class="loading"
      >
        Loading datasets...
      </div>


      <div
        id="error"
        class="error hidden"
      ></div>


      <section
        id="dataset-list"
        class="dataset-list"
      ></section>

    </section>

  </main>


  <script>

    /*
     * ==========================================
     * TEST CONFIGURATION
     * ==========================================
     *
     * This API key is intentionally kept here
     * only because this is your current testing
     * implementation.
     *
     * Move API access to a backend later.
     */

    const API_KEY =
      "d67ef738b51747334c26ca8aebff8b6d";


    const API_BASE =
      "https://microdata.gov.in/NADA/index.php";


    /*
     * ==========================================
     * ELEMENTS
     * ==========================================
     */

    const surveyPage =
      document.querySelector("#survey-page");

    const datasetPage =
      document.querySelector("#dataset-page");

    const cards =
      document.querySelectorAll(".category-card");

    const selectedCategory =
      document.querySelector("#selected-category");

    const datasetCount =
      document.querySelector("#dataset-count");

    const datasetList =
      document.querySelector("#dataset-list");

    const loading =
      document.querySelector("#loading");

    const errorBox =
      document.querySelector("#error");

    const backSurveys =
      document.querySelector("#back-surveys");


    /*
     * ==========================================
     * CARD CLICK
     * ==========================================
     *
     * Clicking a card changes the URL.
     *
     * Example:
     *
     * /dataset-explorer?category=Periodic%20Labour%20Force%20Survey
     *
     * The page then reloads and displays
     * only that survey's datasets.
     */

    cards.forEach((card) => {

      card.addEventListener("click", () => {

        const category =
          card.dataset.category;

        const url =
          new URL(window.location.href);

        url.searchParams.set(
          "category",
          category
        );

        window.location.href =
          url.toString();

      });

    });


    /*
     * ==========================================
     * BACK TO SURVEYS
     * ==========================================
     */

    backSurveys.addEventListener(
      "click",
      () => {

        const url =
          new URL(window.location.href);

        url.searchParams.delete(
          "category"
        );

        window.location.href =
          url.pathname;

      }
    );


    /*
     * ==========================================
     * INITIAL PAGE LOAD
     * ==========================================
     */

    const params =
      new URLSearchParams(
        window.location.search
      );

    const category =
      params.get("category");


    if (category) {

      /*
       * Dataset mode
       */

      surveyPage.classList.add(
        "hidden"
      );

      datasetPage.classList.remove(
        "hidden"
      );

      selectedCategory.textContent =
        category;

      loadDatasets(category);

    } else {

      /*
       * Survey selection mode
       */

      surveyPage.classList.remove(
        "hidden"
      );

      datasetPage.classList.add(
        "hidden"
      );

    }


    /*
     * ==========================================
     * LOAD DATASETS
     * ==========================================
     */

    async function loadDatasets(category) {

      loading.classList.remove(
        "hidden"
      );

      errorBox.classList.add(
        "hidden"
      );

      datasetList.innerHTML = "";

      datasetCount.textContent = "";


      try {

        const response =
          await fetch(
            `${API_BASE}/api/listdatasets`,
            {
              method: "GET",

              headers: {
                "X-API-KEY": API_KEY,
                "Accept": "application/json"
              }
            }
          );


        if (!response.ok) {

          throw new Error(
            `MoSPI API request failed: ${response.status}`
          );

        }


        /*
         * Try JSON first.
         */

        const contentType =
          response.headers.get(
            "content-type"
          ) || "";


        let data;


        if (
          contentType.includes(
            "application/json"
          )
        ) {

          data =
            await response.json();

        } else {

          /*
           * Some NADA installations can
           * return another representation.
           */

          const text =
            await response.text();

          try {

            data =
              JSON.parse(text);

          } catch {

            throw new Error(
              "MoSPI API returned a non-JSON response."
            );

          }

        }


        console.log(
          "MoSPI API response:",
          data
        );


        const datasets =
          normalizeDatasets(data);


        console.log(
          "All datasets:",
          datasets
        );


        /*
         * Filter by collection/category.
         */

        const filtered =
          datasets.filter(
            (dataset) =>
              matchesCategory(
                dataset,
                category
              )
          );


        console.log(
          "Filtered datasets:",
          filtered
        );


        renderDatasets(
          filtered
        );


      } catch (error) {

        console.error(
          "Dataset API error:",
          error
        );


        errorBox.textContent =
          error.message ||
          "Unable to load datasets.";


        errorBox.classList.remove(
          "hidden"
        );

      } finally {

        loading.classList.add(
          "hidden"
        );

      }

    }


    /*
     * ==========================================
     * NORMALIZE API RESPONSE
     * ==========================================
     */

    function normalizeDatasets(data) {

      if (Array.isArray(data)) {

        return data;

      }


      if (
        Array.isArray(
          data?.data
        )
      ) {

        return data.data;

      }


      if (
        Array.isArray(
          data?.result
        )
      ) {

        return data.result;

      }


      if (
        Array.isArray(
          data?.datasets
        )
      ) {

        return data.datasets;

      }


      if (
        Array.isArray(
          data?.message
        )
      ) {

        return data.message;

      }


      return [];

    }


    /*
     * ==========================================
     * CATEGORY MATCHING
     * ==========================================
     */

    function matchesCategory(
      dataset,
      category
    ) {

      const text =
        JSON.stringify(
          dataset
        ).toLowerCase();


      return text.includes(
        category.toLowerCase()
      );

    }


    /*
     * ==========================================
     * RENDER DATASETS
     * ==========================================
     */

    function renderDatasets(
      datasets
    ) {

      datasetList.innerHTML = "";


      datasetCount.textContent =
        `${datasets.length} datasets`;


      if (!datasets.length) {

        datasetList.innerHTML = `

          <div class="empty">

            <div class="empty-icon">
              DB
            </div>

            <strong>
              No datasets found
            </strong>

            <span>
              No datasets were returned for
              this survey category.
            </span>

          </div>

        `;

        return;

      }


      datasets.forEach(
        (dataset) => {

          /*
           * Support different possible
           * field names from the API.
           */

          const title =
            dataset.title ||
            dataset.name ||
            dataset.dataset_title ||
            dataset.Title ||
            dataset.DatasetTitle ||
            "Untitled Dataset";


          const id =
            dataset.id ||
            dataset.dataset_id ||
            dataset.DataSetID ||
            dataset.datasetId ||
            dataset.reference_id ||
            dataset.ReferenceID ||
            "—";


          const year =
            dataset.year ||
            dataset.period ||
            dataset.survey_year ||
            dataset.Year ||
            "";


          const collection =
            dataset.collection ||
            dataset.Collection ||
            dataset.collection_name ||
            "";


          const card =
            document.createElement(
              "article"
            );


          card.className =
            "dataset-card";


          card.innerHTML = `

            <div class="dataset-main">

              <div class="dataset-icon">
                DB
              </div>


              <div class="dataset-info">

                <h2>
                  ${escapeHtml(
                    String(title)
                  )}
                </h2>


                <p class="dataset-id">
                  ${escapeHtml(
                    String(id)
                  )}
                </p>


                ${
                  collection
                    ? `
                      <span class="dataset-collection">
                        ${escapeHtml(
                          String(collection)
                        )}
                      </span>
                    `
                    : ""
                }


                ${
                  year
                    ? `
                      <span class="dataset-year">
                        ${escapeHtml(
                          String(year)
                        )}
                      </span>
                    `
                    : ""
                }

              </div>

            </div>


            <button
              class="view-button"
              type="button"
            >
              View →
            </button>

          `;


          datasetList.appendChild(
            card
          );

        }
      );

    }


    /*
     * ==========================================
     * HTML ESCAPE
     * ==========================================
     */

    function escapeHtml(
      value
    ) {

      return value
        .replaceAll(
          "&",
          "&amp;"
        )
        .replaceAll(
          "<",
          "&lt;"
        )
        .replaceAll(
          ">",
          "&gt;"
        )
        .replaceAll(
          '"',
          "&quot;"
        )
        .replaceAll(
          "'",
          "&#039;"
        );

    }

  </script>

</body>

</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }


  :global(html) {
    margin: 0;
    padding: 0;
    background: #ffffff;
  }


  :global(body) {

    margin: 0;

    padding: 0;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #ffffff;

    color: #111827;

  }


  /*
   * ==========================================
   * MAIN CONTAINER
   * ==========================================
   */

  .explorer {

    width:
      min(
        1100px,
        calc(100% - 48px)
      );

    margin:
      0 auto;

    padding:
      48px 0 80px;

  }


  /*
   * ==========================================
   * HEADER
   * ==========================================
   */

  .page-header {

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      flex-start;

    margin-bottom:
      28px;

  }


  .eyebrow {

    margin:
      0 0 8px;

    font-size:
      11px;

    font-weight:
      800;

    letter-spacing:
      .14em;

    color:
      #64748b;

  }


  h1 {

    margin:
      0;

    font-size:
      38px;

    line-height:
      1.08;

    letter-spacing:
      -.035em;

    color:
      #111827;

  }


  .subtitle {

    margin:
      10px 0 0;

    color:
      #64748b;

    font-size:
      15px;

  }


  .back-button {

    display:
      inline-flex;

    align-items:
      center;

    padding:
      10px 16px;

    border:
      1px solid #d1d5db;

    border-radius:
      8px;

    color:
      #111827;

    text-decoration:
      none;

    background:
      #ffffff;

    font-size:
      14px;

    font-weight:
      600;

  }


  .back-button:hover {

    background:
      #f8fafc;

  }


  /*
   * ==========================================
   * 9 SURVEY CARDS
   * ==========================================
   */

  .category-grid {

    display:
      grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );

    gap:
      18px;

  }


  .category-card {

    position:
      relative;

    height:
      125px;

    padding:
      22px;

    border:
      1px solid #262626;

    border-radius:
      8px;

    background:
      #ffffff;

    cursor:
      pointer;

    text-align:
      center;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    transition:
      transform .15s ease,
      box-shadow .15s ease,
      border-color .15s ease;

  }


  .category-card:hover {

    transform:
      translateY(-2px);

    border-color:
      #0071bc;

    box-shadow:
      0 8px 20px
      rgba(
        0,
        0,
        0,
        .08
      );

  }


  .category-code {

    display:
      none;

  }


  .category-name {

    max-width:
      270px;

    font-size:
      21px;

    line-height:
      1.25;

    font-weight:
      750;

    color:
      #0071bc;

  }


  .category-arrow {

    display:
      none;

  }


  /*
   * ==========================================
   * DATASET PAGE
   * ==========================================
   */

  .dataset-header {

    position:
      relative;

    padding-bottom:
      28px;

    border-bottom:
      1px solid #e5e7eb;

    margin-bottom:
      26px;

  }


  .dataset-heading {

    text-align:
      center;

    padding-top:
      14px;

  }


  .dataset-heading h1 {

    font-size:
      34px;

    color:
      #0071bc;

  }


  .dataset-heading .subtitle {

    font-size:
      14px;

  }


  .back-surveys {

    position:
      absolute;

    left:
      0;

    top:
      0;

    border:
      1px solid #d1d5db;

    border-radius:
      8px;

    background:
      #ffffff;

    padding:
      9px 14px;

    font-size:
      13px;

    font-weight:
      650;

    cursor:
      pointer;

    color:
      #111827;

  }


  .back-surveys:hover {

    background:
      #f8fafc;

  }


  .count {

    display:
      block;

    text-align:
      center;

    margin-top:
      12px;

    color:
      #64748b;

    font-size:
      13px;

  }


  /*
   * ==========================================
   * DATASET LIST
   * ==========================================
   */

  .dataset-list {

    display:
      grid;

    grid-template-columns:
      1fr;

    gap:
      12px;

  }


  .dataset-card {

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    min-height:
      92px;

    padding:
      18px 20px;

    border:
      1px solid #dfe3e8;

    border-radius:
      8px;

    background:
      #ffffff;

    transition:
      box-shadow .15s ease,
      border-color .15s ease;

  }


  .dataset-card:hover {

    border-color:
      #b8c2cc;

    box-shadow:
      0 5px 18px
      rgba(
        0,
        0,
        0,
        .06
      );

  }


  .dataset-main {

    display:
      flex;

    align-items:
      center;

    gap:
      15px;

    min-width:
      0;

  }


  .dataset-icon {

    flex:
      0 0 auto;

    width:
      42px;

    height:
      42px;

    display:
      grid;

    place-items:
      center;

    border-radius:
      8px;

    background:
      #eef6fc;

    color:
      #0071bc;

    font-size:
      11px;

    font-weight:
      800;

  }


  .dataset-info {

    min-width:
      0;

  }


  .dataset-info h2 {

    margin:
      0;

    font-size:
      16px;

    line-height:
      1.35;

    font-weight:
      700;

    color:
      #111827;

  }


  .dataset-id {

    margin:
      5px 0 0;

    color:
      #64748b;

    font-size:
      12px;

    word-break:
      break-word;

  }


  .dataset-collection {

    display:
      inline-block;

    margin-top:
      6px;

    margin-right:
      8px;

    padding:
      3px 7px;

    border-radius:
      4px;

    background:
      #f1f5f9;

    color:
      #475569;

    font-size:
      10px;

    font-weight:
      700;

  }


  .dataset-year {

    display:
      inline-block;

    margin-top:
      6px;

    color:
      #0071bc;

    font-size:
      11px;

  }


  .view-button {

    flex:
      0 0 auto;

    margin-left:
      20px;

    padding:
      9px 14px;

    border:
      0;

    border-radius:
      7px;

    background:
      #0071bc;

    color:
      #ffffff;

    font-size:
      13px;

    font-weight:
      700;

    cursor:
      pointer;

  }


  .view-button:hover {

    background:
      #005a96;

  }


  /*
   * ==========================================
   * LOADING
   * ==========================================
   */

  .loading {

    padding:
      40px;

    text-align:
      center;

    color:
      #64748b;

    font-size:
      14px;

    border:
      1px solid #e5e7eb;

    border-radius:
      8px;

    background:
      #ffffff;

  }


  /*
   * ==========================================
   * ERROR
   * ==========================================
   */

  .error {

    padding:
      18px 20px;

    border:
      1px solid #fecaca;

    border-radius:
      8px;

    background:
      #fff7f7;

    color:
      #b91c1c;

    font-size:
      14px;

  }


  /*
   * ==========================================
   * EMPTY
   * ==========================================
   */

  .empty {

    display:
      flex;

    flex-direction:
      column;

    align-items:
      center;

    justify-content:
      center;

    gap:
      8px;

    min-height:
      180px;

    border:
      1px solid #e5e7eb;

    border-radius:
      8px;

    text-align:
      center;

  }


  .empty-icon {

    display:
      grid;

    place-items:
      center;

    width:
      42px;

    height:
      42px;

    margin-bottom:
      4px;

    border-radius:
      8px;

    background:
      #eef6fc;

    color:
      #0071bc;

    font-size:
      11px;

    font-weight:
      800;

  }


  .empty strong {

    font-size:
      15px;

  }


  .empty span {

    color:
      #64748b;

    font-size:
      13px;

  }


  /*
   * ==========================================
   * HIDDEN
   * ==========================================
   */

  .hidden {

    display:
      none !important;

  }


  /*
   * ==========================================
   * RESPONSIVE
   * ==========================================
   */

  @media (max-width: 800px) {

    .explorer {

      width:
        min(
          100% - 28px,
          600px
        );

      padding-top:
        30px;

    }


    .category-grid {

      grid-template-columns:
        1fr;

    }


    .category-card {

      height:
        105px;

    }


    .page-header {

      flex-direction:
        column;

      gap:
        18px;

    }


    .dataset-heading {

      padding-top:
        55px;

    }


    .dataset-heading h1 {

      font-size:
        28px;

    }


    .dataset-card {

      align-items:
        flex-start;

      gap:
        15px;

    }


    .view-button {

      margin-left:
        0;

    }

  }

</style>